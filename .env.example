# ==============================================================================
# AUTONOMOUS ECONOMIC INTELLIGENCE & OPPORTUNITY ENGINE
# Environment Configuration Template (.env.example)
#
# COPY THIS FILE TO `.env` AND FILL IN YOUR CREDENTIALS:
#   cp .env.example .env
#
# NEVER COMMIT YOUR REAL `.env` FILE OR ANY SENSITIVE CREDENTIALS TO GIT.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Server & Runtime
# ------------------------------------------------------------------------------
AI_OP_ENVIRONMENT=development
AI_OP_DEBUG=false
AI_OP_LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000

# Primary LLM provider selection: 'omniroute', 'freellmapi', 'gemini', 'openai', or 'mock'
DEFAULT_LLM_PROVIDER=omniroute

# ------------------------------------------------------------------------------
# 2. OmniRoute Autonomous Multi-Provider Router Gateway
#    Local or remote OpenAI-compatible router (default: http://127.0.0.1:20128/v1)
# ------------------------------------------------------------------------------
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_API_KEY=your_omniroute_api_key_here
OMNIROUTE_DEFAULT_MODEL=research-general

# ------------------------------------------------------------------------------
# 3. FreeLLMAPI Autonomous Inference Layer
#    High-throughput local API gateway / proxy (default: http://127.0.0.1:3001/v1)
# ------------------------------------------------------------------------------
FREELLMAPI_URL=http://localhost:3001
FREELLMAPI_BASE_URL=http://localhost:3001/v1
FREELLMAPI_API_KEY=your_freellmapi_api_key_here
FREELLMAPI_DEFAULT_MODEL=auto

# ------------------------------------------------------------------------------
# 4. Direct Cloud Model Providers (Fallback or Direct Routing)
# ------------------------------------------------------------------------------
# Google Gemini API
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-3.7-flash

# OpenAI API
# Obtain from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# Groq Cloud API (Optional fast inference acceleration)
GROQ_API_KEY=your_groq_api_key_here

# ------------------------------------------------------------------------------
# 5. Agent Reach & Internet Discovery Backends
# ------------------------------------------------------------------------------
AGENT_REACH_ENABLED=true
AGENT_REACH_SEARCH_BACKEND=exa

# Exa Neural Search API (https://exa.ai)
EXA_API_KEY=your_exa_api_key_here

# GitHub Token for documentation and repository search tools (optional)
GITHUB_TOKEN=your_github_token_here

# ------------------------------------------------------------------------------
# 6. Multi-Platform Client Routing (Codex, DeepSeek, OpenCode, Claude)
#    Configure custom endpoint URLs if routing through specific internal proxies
# ------------------------------------------------------------------------------
CODEX_BASE_URL=http://localhost:3001/v1
CODEX_API_KEY=your_codex_api_key_here

DEEPSEEK_BASE_URL=http://localhost:3001/v1
DEEPSEEK_API_KEY=your_deepseek_api_key_here

OPENCODE_BASE_URL=http://localhost:3001/v1
OPENCODE_API_KEY=your_opencode_api_key_here

ANTHROPIC_BASE_URL=http://localhost:3001
ANTHROPIC_AUTH_TOKEN=your_anthropic_auth_token_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ------------------------------------------------------------------------------
# 7. Persistence & Ledger Storage
# ------------------------------------------------------------------------------
DATABASE_URL=sqlite:///output/intelligence_ledger.db
